{
  "name": "@uml-drawer/theme",
  "version": "0.1.2",
  "private": false,
  "description": "Design-agnostic theming contract for UML Drawer JS — --uml-* CSS variables with neutral light/dark defaults.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./contract.css": "./dist/contract.css",
    "./defaults-light.css": "./dist/defaults-light.css",
    "./defaults-dark.css": "./dist/defaults-dark.css",
    "./index.css": "./dist/index.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "uml",
    "theme",
    "css-variables",
    "design-tokens",
    "uml-drawer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Salvadore1987/uml-drawerjs.git",
    "directory": "packages/theme"
  }
}
