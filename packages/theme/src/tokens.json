{
  "$schema": "https://uml-drawer.dev/schemas/theme-tokens.v1.json",
  "version": "0.0.0",
  "namespace": "uml",
  "hostSelector": "[data-uml-host]",
  "themes": ["light", "dark"],
  "themeAttribute": "data-theme",
  "categories": {
    "surface": "Backgrounds for the editor host, panels, and overlays.",
    "text": "Foreground text colours by emphasis level.",
    "border": "Strokes for dividers, panel borders, and outlines.",
    "semantic": "Status / accent colours used by validators, lint, and active states.",
    "node": "Default fills, strokes, and labels for diagram nodes.",
    "edge": "Stroke / arrow / label colours for diagram edges.",
    "canvas": "Backdrop and grid colours for the diagram canvas.",
    "selection": "Selection rectangle, drag handles, and keyboard focus ring.",
    "typography": "Font stacks, sizes, and line height (theme-independent).",
    "radius": "Corner radii for panels, nodes, badges (theme-independent).",
    "shadow": "Elevation shadows (theme-dependent).",
    "motion": "Theme-switch transition duration (theme-independent)."
  },
  "tokens": [
    {
      "name": "--uml-bg",
      "category": "surface",
      "type": "color",
      "themed": true,
      "description": "Primary editor background. Applied to the host element by default.",
      "defaults": { "light": "#ffffff", "dark": "#0f172a" }
    },
    {
      "name": "--uml-bg-elevated",
      "category": "surface",
      "type": "color",
      "themed": true,
      "description": "Background for elevated surfaces: palette, props panel, outline.",
      "defaults": { "light": "#f8fafc", "dark": "#1e293b" }
    },
    {
      "name": "--uml-bg-overlay",
      "category": "surface",
      "type": "color",
      "themed": true,
      "description": "Background for transient overlays: popovers, dialogs, command channel.",
      "defaults": { "light": "#ffffff", "dark": "#1e293b" }
    },
    {
      "name": "--uml-text",
      "category": "text",
      "type": "color",
      "themed": true,
      "description": "Primary foreground text colour.",
      "defaults": { "light": "#0f172a", "dark": "#f1f5f9" }
    },
    {
      "name": "--uml-text-muted",
      "category": "text",
      "type": "color",
      "themed": true,
      "description": "Secondary text colour for labels and helper copy.",
      "defaults": { "light": "#475569", "dark": "#94a3b8" }
    },
    {
      "name": "--uml-text-faint",
      "category": "text",
      "type": "color",
      "themed": true,
      "description": "Tertiary text colour for placeholders and disabled state.",
      "defaults": { "light": "#94a3b8", "dark": "#64748b" }
    },
    {
      "name": "--uml-text-on-accent",
      "category": "text",
      "type": "color",
      "themed": true,
      "description": "Foreground colour used on top of `--uml-accent` fills.",
      "defaults": { "light": "#ffffff", "dark": "#0f172a" }
    },
    {
      "name": "--uml-border",
      "category": "border",
      "type": "color",
      "themed": true,
      "description": "Default border colour for panels and inputs.",
      "defaults": { "light": "#e2e8f0", "dark": "#334155" }
    },
    {
      "name": "--uml-border-subtle",
      "category": "border",
      "type": "color",
      "themed": true,
      "description": "Low-emphasis dividers (rows, separators).",
      "defaults": { "light": "#f1f5f9", "dark": "#1e293b" }
    },
    {
      "name": "--uml-border-strong",
      "category": "border",
      "type": "color",
      "themed": true,
      "description": "High-emphasis borders (active inputs, focused panels).",
      "defaults": { "light": "#cbd5e1", "dark": "#475569" }
    },
    {
      "name": "--uml-accent",
      "category": "semantic",
      "type": "color",
      "themed": true,
      "description": "Primary accent colour (active state, primary buttons).",
      "defaults": { "light": "#2563eb", "dark": "#60a5fa" }
    },
    {
      "name": "--uml-success",
      "category": "semantic",
      "type": "color",
      "themed": true,
      "description": "Success / valid state colour.",
      "defaults": { "light": "#16a34a", "dark": "#4ade80" }
    },
    {
      "name": "--uml-warning",
      "category": "semantic",
      "type": "color",
      "themed": true,
      "description": "Warning / lint colour.",
      "defaults": { "light": "#ca8a04", "dark": "#facc15" }
    },
    {
      "name": "--uml-danger",
      "category": "semantic",
      "type": "color",
      "themed": true,
      "description": "Error / destructive state colour.",
      "defaults": { "light": "#dc2626", "dark": "#f87171" }
    },
    {
      "name": "--uml-info",
      "category": "semantic",
      "type": "color",
      "themed": true,
      "description": "Informational / neutral status colour.",
      "defaults": { "light": "#0284c7", "dark": "#38bdf8" }
    },
    {
      "name": "--uml-node-bg",
      "category": "node",
      "type": "color",
      "themed": true,
      "description": "Default node fill.",
      "defaults": { "light": "#ffffff", "dark": "#1e293b" }
    },
    {
      "name": "--uml-node-text",
      "category": "node",
      "type": "color",
      "themed": true,
      "description": "Default node label colour.",
      "defaults": { "light": "#0f172a", "dark": "#f1f5f9" }
    },
    {
      "name": "--uml-node-border",
      "category": "node",
      "type": "color",
      "themed": true,
      "description": "Default node stroke colour.",
      "defaults": { "light": "#cbd5e1", "dark": "#475569" }
    },
    {
      "name": "--uml-node-stereotype",
      "category": "node",
      "type": "color",
      "themed": true,
      "description": "Stereotype badge / kind-marker text colour.",
      "defaults": { "light": "#64748b", "dark": "#94a3b8" }
    },
    {
      "name": "--uml-edge-stroke",
      "category": "edge",
      "type": "color",
      "themed": true,
      "description": "Default edge stroke colour.",
      "defaults": { "light": "#475569", "dark": "#94a3b8" }
    },
    {
      "name": "--uml-edge-arrow",
      "category": "edge",
      "type": "color",
      "themed": true,
      "description": "Default arrowhead fill colour.",
      "defaults": { "light": "#475569", "dark": "#94a3b8" }
    },
    {
      "name": "--uml-edge-label-bg",
      "category": "edge",
      "type": "color",
      "themed": true,
      "description": "Background pill for edge labels (cardinality, multiplicity).",
      "defaults": { "light": "#ffffff", "dark": "#1e293b" }
    },
    {
      "name": "--uml-edge-label-text",
      "category": "edge",
      "type": "color",
      "themed": true,
      "description": "Edge label text colour.",
      "defaults": { "light": "#475569", "dark": "#cbd5e1" }
    },
    {
      "name": "--uml-edge-stroke-width",
      "category": "edge",
      "type": "length",
      "themed": false,
      "description": "Default edge stroke width.",
      "default": "1.5px"
    },
    {
      "name": "--uml-canvas-bg",
      "category": "canvas",
      "type": "color",
      "themed": true,
      "description": "Canvas backdrop colour.",
      "defaults": { "light": "#f8fafc", "dark": "#0b1120" }
    },
    {
      "name": "--uml-canvas-grid",
      "category": "canvas",
      "type": "color",
      "themed": true,
      "description": "Dot-grid colour on the canvas.",
      "defaults": { "light": "#e2e8f0", "dark": "#1e293b" }
    },
    {
      "name": "--uml-canvas-grid-density",
      "category": "canvas",
      "type": "length",
      "themed": false,
      "description": "Spacing between dot-grid points (px).",
      "default": "24px"
    },
    {
      "name": "--uml-selection-fill",
      "category": "selection",
      "type": "color",
      "themed": true,
      "description": "Selection-rectangle fill colour.",
      "defaults": {
        "light": "rgba(37, 99, 235, 0.1)",
        "dark": "rgba(96, 165, 250, 0.15)"
      }
    },
    {
      "name": "--uml-selection-stroke",
      "category": "selection",
      "type": "color",
      "themed": true,
      "description": "Selection-rectangle stroke colour.",
      "defaults": { "light": "#2563eb", "dark": "#60a5fa" }
    },
    {
      "name": "--uml-selection-handle",
      "category": "selection",
      "type": "color",
      "themed": true,
      "description": "Drag-handle fill colour.",
      "defaults": { "light": "#2563eb", "dark": "#60a5fa" }
    },
    {
      "name": "--uml-focus-ring",
      "category": "selection",
      "type": "color",
      "themed": true,
      "description": "Keyboard-focus ring colour.",
      "defaults": { "light": "#2563eb", "dark": "#60a5fa" }
    },
    {
      "name": "--uml-font-sans",
      "category": "typography",
      "type": "font-family",
      "themed": false,
      "description": "Sans-serif font stack used by editor chrome and node labels.",
      "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
    },
    {
      "name": "--uml-font-mono",
      "category": "typography",
      "type": "font-family",
      "themed": false,
      "description": "Monospace font stack used by the text editor.",
      "default": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
    },
    {
      "name": "--uml-font-size-sm",
      "category": "typography",
      "type": "length",
      "themed": false,
      "description": "Small font size (helper text).",
      "default": "12px"
    },
    {
      "name": "--uml-font-size-base",
      "category": "typography",
      "type": "length",
      "themed": false,
      "description": "Base font size for the editor.",
      "default": "14px"
    },
    {
      "name": "--uml-font-size-lg",
      "category": "typography",
      "type": "length",
      "themed": false,
      "description": "Large font size (section headers).",
      "default": "16px"
    },
    {
      "name": "--uml-line-height",
      "category": "typography",
      "type": "number",
      "themed": false,
      "description": "Default line height multiplier.",
      "default": "1.5"
    },
    {
      "name": "--uml-radius-sm",
      "category": "radius",
      "type": "length",
      "themed": false,
      "description": "Small corner radius (badges, pills).",
      "default": "4px"
    },
    {
      "name": "--uml-radius-md",
      "category": "radius",
      "type": "length",
      "themed": false,
      "description": "Medium corner radius (buttons, inputs, nodes).",
      "default": "8px"
    },
    {
      "name": "--uml-radius-lg",
      "category": "radius",
      "type": "length",
      "themed": false,
      "description": "Large corner radius (panels, dialogs).",
      "default": "12px"
    },
    {
      "name": "--uml-shadow-sm",
      "category": "shadow",
      "type": "shadow",
      "themed": true,
      "description": "Small elevation shadow (badges, tooltips).",
      "defaults": {
        "light": "0 1px 2px rgba(15, 23, 42, 0.06)",
        "dark": "0 1px 2px rgba(0, 0, 0, 0.4)"
      }
    },
    {
      "name": "--uml-shadow-md",
      "category": "shadow",
      "type": "shadow",
      "themed": true,
      "description": "Medium elevation shadow (popovers, panels).",
      "defaults": {
        "light": "0 4px 12px rgba(15, 23, 42, 0.1)",
        "dark": "0 4px 12px rgba(0, 0, 0, 0.45)"
      }
    },
    {
      "name": "--uml-shadow-lg",
      "category": "shadow",
      "type": "shadow",
      "themed": true,
      "description": "Large elevation shadow (modals, drag previews).",
      "defaults": {
        "light": "0 12px 32px rgba(15, 23, 42, 0.15)",
        "dark": "0 12px 32px rgba(0, 0, 0, 0.5)"
      }
    },
    {
      "name": "--uml-transition-theme",
      "category": "motion",
      "type": "duration",
      "themed": false,
      "description": "Duration of `background-color` / `color` transitions on theme switch (200–400 ms per spec).",
      "default": "0.3s"
    }
  ]
}
