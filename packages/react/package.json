{
  "name": "@uml-drawer/react",
  "version": "0.1.4",
  "private": false,
  "description": "React 18+ adapter for UML Drawer JS — design-agnostic <UmlEditor> root + Canvas / Palette / PropsPanel / TextEditor / Outline / HUD / CommandChannel / Statusbar primitives, all driven by --uml-* theming tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@uml-drawer/core": "workspace:^"
  },
  "peerDependencies": {
    "@uml-drawer/theme": "workspace:^",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@uml-drawer/theme": "workspace:^",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "uml",
    "plantuml",
    "react",
    "diagram",
    "uml-drawer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Salvadore1987/uml-drawerjs.git",
    "directory": "packages/react"
  }
}
