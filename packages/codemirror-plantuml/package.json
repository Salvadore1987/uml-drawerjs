{
  "name": "@uml-drawer/codemirror-plantuml",
  "version": "0.1.0",
  "private": false,
  "description": "CodeMirror 6 language extension for the PlantUML subset supported by UML Drawer JS — syntax highlighting, diagnostics with quick-fix lens, context-aware autocomplete, and snippets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "import": "./dist/language.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "import": "./dist/lint.js"
    },
    "./autocomplete": {
      "types": "./dist/autocomplete.d.ts",
      "import": "./dist/autocomplete.js"
    },
    "./snippets": {
      "types": "./dist/snippets.d.ts",
      "import": "./dist/snippets.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.1"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@uml-drawer/core": "workspace:^"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@uml-drawer/core": "workspace:^",
    "happy-dom": "^15.11.7",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "uml",
    "plantuml",
    "codemirror",
    "codemirror6",
    "language",
    "uml-drawer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Salvadore1987/uml-drawerjs.git",
    "directory": "packages/codemirror-plantuml"
  }
}
